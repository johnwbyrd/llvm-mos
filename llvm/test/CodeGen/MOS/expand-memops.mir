# Test that memmove uses forward loop (preserves overlapping semantics)
---
name: memmove_basic
tracksRegLiveness: true
body: |
  bb.0.entry:
    liveins: $rc2, $rc3, $rc4, $rc5, $rc6, $rc7
    ; CHECK-LABEL: name: memmove_basic
    ; CHECK: successors: %bb.1(0x80000000)
    ; CHECK-NEXT: liveins: $rc2, $rc3, $rc4, $rc5, $rc6, $rc7
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $y = LDImm 0
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: .1.entry:
    ; CHECK-NEXT: successors: %bb.1(0x40000000), %bb.2(0x40000000)
    ; CHECK-NEXT: liveins: $y, $rs2, $rc6, $rs3
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $a = LDIndirIdx $rs3, $y
    ; CHECK-NEXT: STIndirIdx $a, $rs2, $y
    ; CHECK-NEXT: INY_Implied
    ; CHECK-NEXT: CmpBrImag8 %bb.1, undef $z, 0, $y, $rc6, implicit-def $c
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: .2.entry:
    ; CHECK-NEXT: RTS
    MemMove $rs2, $rs3, $rc6, $rc7, implicit-def $a, implicit-def $x, implicit-def $y, implicit-def $c, implicit-def $n, implicit-def $v, implicit-def $z
    RTS
...

